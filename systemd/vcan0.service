[Unit]
Description=LinSight vcan0 virtual CAN interface
After=network.target
Before=linsightd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/modprobe vcan
ExecStart=-/usr/sbin/ip link add dev vcan0 type vcan
ExecStart=/usr/sbin/ip link set up vcan0

[Install]
WantedBy=multi-user.target
