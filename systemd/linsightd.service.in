[Unit]
Description=LinSight CAN bridge daemon
After=network-online.target vcan0.service
Wants=network-online.target vcan0.service

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=-@CMAKE_INSTALL_FULL_SYSCONFDIR@/default/linsightd
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/linsightd $LINSIGHTD_ARGS
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
