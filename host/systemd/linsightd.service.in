[Unit]
Description=LinSight CAN capture daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=linsight
RuntimeDirectory=linsight
EnvironmentFile=-@CMAKE_INSTALL_FULL_SYSCONFDIR@/default/linsightd
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/linsightd $LINSIGHTD_ARGS
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/linsight /run/linsight
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
